<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>CielWin.App</RootNamespace>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Unelevated (asInvoker) + PerMonitorV2. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>cielwin.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="cielwin.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Served through WebView2's SetVirtualHostNameToFolderMapping, which maps a virtual host to a
         real folder, so the scene pages ship as loose content files next to the executable. -->
    <Content Include="Wallpaper\Web\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- UseWindowsForms implicitly globals System.Drawing/System.Windows.Forms, which collide with
         WPF types. Scope them back down to explicit usings where needed (tray icon). -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CielWin.App.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.321" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CielWin.Interop\CielWin.Interop.csproj" />
  </ItemGroup>
</Project>
